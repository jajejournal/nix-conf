# Only what is specific to THIS machine.
# Everything else (the desktop/rice) is shared in modules/ and home/.
{ config, pkgs, lib, inputs, ... }:
{
  imports = [
    ./hardware-configuration.nix   # generated by ./install.sh or nixos-generate-config
    # If your model has a nixos-hardware module, add it here, e.g.:
    # inputs.nixos-hardware.nixosModules.lenovo-thinkpad-t420
  ];

  networking.hostName = "HOSTNAME_PLACEHOLDER";

  # --- Boot ---
  # UEFI (most machines): systemd-boot.
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;
  boot.loader.systemd-boot.configurationLimit = 10;
  # BIOS-only machine: comment the three lines above and use GRUB instead:
  #   boot.loader.grub = { enable = true; device = "/dev/sda"; };
  #   and add a { size = "1M"; type = "EF02"; } partition to hosts/<name>/disko.nix.

  # --- Graphics ---
  # Old Intel GPUs (HD 3000, etc.) need VAAPI for hardware video decode.
  # Uncomment these two lines on those machines; leave them off on other GPUs.
  # hardware.graphics.extraPackages = [ pkgs.intel-vaapi-driver ];
  # environment.sessionVariables.LIBVA_DRIVER_NAME = "i965";
}
