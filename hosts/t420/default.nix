# Only what is specific to THIS laptop (ThinkPad T420, Intel HD 3000 graphics).
{ config, pkgs, lib, inputs, ... }:
{
  imports = [
    ./hardware-configuration.nix                 # generated by nixos-generate-config / install.sh
    inputs.nixos-hardware.nixosModules.lenovo-thinkpad-t420
  ];

  networking.hostName = "t420";

  # --- Boot ---
  # systemd-boot requires UEFI. For a BIOS-only machine use GRUB (see README).
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;
  boot.loader.systemd-boot.configurationLimit = 10;

  # --- Intel HD 3000 (VAAPI) ---
  hardware.graphics.extraPackages = [ pkgs.intel-vaapi-driver ];
  environment.sessionVariables.LIBVA_DRIVER_NAME = "i965";

  # Example for another machine (copy this hosts/<name> folder and adjust):
  #   - networking.hostName
  #   - hardware-configuration.nix
  #   - the matching nixos-hardware module
  #   - if it has no battery, remove the "battery" module from home/polybar.nix
}
